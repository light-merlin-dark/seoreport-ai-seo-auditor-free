{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "targetUrl": {
        "type": "string",
        "title": "Target URL",
        "description": "Normalized website URL that was audited."
      },
      "jobId": {
        "type": ["string", "null"],
        "title": "Job ID",
        "description": "SEOReport job identifier for this run."
      },
      "overallScore": {
        "type": ["number", "null"],
        "title": "Overall score",
        "description": "0-100 overall grade."
      },
      "seoScore": {
        "type": ["number", "null"],
        "title": "SEO score",
        "description": "0-100 SEO domain score."
      },
      "aiScore": {
        "type": ["number", "null"],
        "title": "AI readiness score",
        "description": "0-100 AI/GEO domain score."
      },
      "performanceScore": {
        "type": ["number", "null"],
        "title": "Performance score",
        "description": "0-100 performance domain score."
      },
      "securityScore": {
        "type": ["number", "null"],
        "title": "Security score",
        "description": "0-100 security domain score."
      },
      "paidUnlocked": {
        "type": "boolean",
        "title": "Paid sections unlocked",
        "description": "Whether this run returned the unlocked advanced report."
      }
    },
    "required": ["targetUrl", "paidUnlocked"]
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": [
          "targetUrl",
          "overallScore",
          "seoScore",
          "aiScore",
          "performanceScore",
          "securityScore",
          "jobId",
          "paidUnlocked"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "targetUrl": { "label": "URL", "format": "link" },
          "overallScore": { "label": "Overall", "format": "number" },
          "seoScore": { "label": "SEO", "format": "number" },
          "aiScore": { "label": "AI", "format": "number" },
          "performanceScore": { "label": "Performance", "format": "number" },
          "securityScore": { "label": "Security", "format": "number" },
          "paidUnlocked": { "label": "Unlocked", "format": "boolean" }
        }
      }
    }
  }
}
